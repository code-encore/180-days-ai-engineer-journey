Problem 4: Operators

a = 15
b = 4

print("\nArithmetic Operators")
print("Addition:", a + b)
print("Subtraction:", a - b)
print("Multiplication:", a * b)
print("Division:", a / b)
print("Modulus:", a % b)

Problem 5: Control Flow (if-else)

marks = 78

print("\nGrade Evaluation")

if marks >= 90:
print("Grade A")
elif marks >= 75:
print("Grade B")
elif marks >= 60:
print("Grade C")
else:
print("Need Improvement")

